---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Error" nav={false}>
  <div class="flex min-h-[60dvh] flex-col items-center justify-center text-center">
    <p class="text-[64px] leading-none font-semibold tracking-[-3px]">&gt;_ 500</p>
    <h1 class="mt-4 text-lg">algo falló en el servidor</h1>
    <p class="mt-1 text-sm text-muted">intenta de nuevo en un momento.</p>
    <a href="/" class="btn-primary mt-6">volver a las herramientas</a>
  </div>
</Layout>
