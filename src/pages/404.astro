---
import Layout from '../layouts/Layout.astro';
---

<Layout title="No encontrada" nav={false}>
  <div class="flex min-h-[60dvh] flex-col items-center justify-center text-center">
    <p class="text-[64px] leading-none font-semibold tracking-[-3px]">&gt;_ 404</p>
    <h1 class="mt-4 text-lg">esta página no existe</h1>
    <p class="mt-1 text-sm text-muted">puede que el link esté mal escrito o que la herramienta ya no esté.</p>
    <a href="/" class="btn-primary mt-6">volver a las herramientas</a>
  </div>
</Layout>
