---
// Aviso informativo, no de consentimiento: el sitio solo usa una cookie estrictamente necesaria (la sesión)
// y guarda preferencias en el navegador. Sin publicidad ni analítica, no hay nada que aceptar o rechazar.
---

<aside id="cookie-notice" class="cookie-notice" aria-label="Aviso de cookies" hidden>
  <p class="text-[13px] leading-relaxed">
    solo usamos una cookie para mantener tu sesión, y tu navegador guarda el tema y la cola de descargas. sin
    publicidad ni rastreo. <a href="/privacidad" class="underline">más info</a>
  </p>
  <button type="button" id="cookie-ok" class="btn-primary shrink-0">entendido</button>
</aside>

<style is:global>
  .cookie-notice {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 50;
    transform: translateX(-50%);
    width: min(560px, calc(100vw - 32px));
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    box-sizing: border-box;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.12);
  }
  .cookie-notice[hidden] {
    display: none;
  }
  /* En el celular queda sobre la barra de herramientas. */
  @media (max-width: 767px) {
    .cookie-notice {
      bottom: calc(84px + env(safe-area-inset-bottom));
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  const KEY = 'cookie-notice-ok';
  const notice = document.querySelector<HTMLElement>('#cookie-notice')!;
  let seen = false;
  try {
    seen = localStorage.getItem(KEY) === '1';
  } catch {}
  notice.hidden = seen;
  document.querySelector('#cookie-ok')!.addEventListener('click', () => {
    notice.hidden = true;
    try {
      localStorage.setItem(KEY, '1');
    } catch {}
  });
</script>
