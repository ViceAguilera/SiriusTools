# Clave para entrar: exactamente 5 caracteres. Mejor letras y números (ej. k7m2x) que solo números.
# Cambiarla cierra todas las sesiones abiertas.
TOOLS_PASSWORD=
# Mínimo 32 caracteres. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# true solo detrás de Nginx (con proxy_set_header X-Forwarded-For $remote_addr).
# En false los límites por IP usan la IP de la conexión y no se pueden falsear con cabeceras.
TRUST_PROXY=false

# Ejecutable de yt-dlp. En Docker ya viene instalado; en local: winget install yt-dlp.yt-dlp
YTDLP_PATH=yt-dlp

# Generador de tokens PO (contenedor bgutil-ytdlp-pot-provider): evita el "confirm you're not a bot" de YouTube.
# En Docker lo define docker-compose.yml (servicio "pot"); en local no hace falta. Sin definir: sin tokens.
# YTDLP_POT_URL=
